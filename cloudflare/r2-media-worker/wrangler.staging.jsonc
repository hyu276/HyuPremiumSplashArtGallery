{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hyu-premium-media-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "cache": {
    "enabled": true
  },
  "vars": {
    "REPO_FULL_NAME": "hyu276/HyuPremiumSplashArtGallery",
    "REPO_OWNER": "hyu276"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "hyu-premium-media"
    }
  ]
}
