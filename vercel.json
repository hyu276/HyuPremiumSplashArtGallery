{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "rewrites": [
    {"source":"/api/seo-manager","destination":"/api/seo-manager/"}
  ],
  "redirects": [
    {"source":"/favicon.ico","destination":"/icon.svg","permanent":true}
  ],
  "headers": [
    {"source":"/robots.txt","headers":[{"key":"Cache-Control","value":"public, max-age=0, s-maxage=3600"}]},
    {"source":"/sitemap.xml","headers":[{"key":"Cache-Control","value":"public, max-age=0, s-maxage=3600"}]},
    {"source":"/image-sitemap.xml","headers":[{"key":"Cache-Control","value":"public, max-age=0, s-maxage=3600"}]},
    {"source":"/icon.svg","headers":[
      {"key":"Cache-Control","value":"public, max-age=31536000, immutable"},
      {"key":"CDN-Cache-Control","value":"public, max-age=31536000, immutable"},
      {"key":"Content-Type","value":"image/svg+xml; charset=utf-8"}
    ]}
  ]
}
