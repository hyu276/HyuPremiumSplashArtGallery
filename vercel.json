{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "/character/", "permanent": true },
    { "source": "/characters/", "destination": "/character/", "permanent": true },
    { "source": "/about.html", "destination": "/about", "permanent": true },
    { "source": "/news.html", "destination": "/news", "permanent": true },
    { "source": "/blog.html", "destination": "/blog", "permanent": true }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/news", "destination": "/news/index.html" },
    { "source": "/blog", "destination": "/blog/index.html" }
  ],
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=3600" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=3600" }]
    },
    {
      "source": "/image-sitemap.xml",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=3600" }]
    }
  ]
}
