{
  "framework": "nextjs",
  "buildCommand": "npm run egress:check && npm run build",
  "outputDirectory": ".next",
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != main ] && exit 0; a=\"$(git diff --name-only HEAD^ HEAD)\" || exit 1; echo \"$a\" | grep -qx khungskin.html || exit 1; echo \"$a\" | grep -Eqv \"^(khungskin[.]html|AGENTS[.]md|vercel[.]json)$\" && exit 1; exit 0",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  },
  "rewrites": [
    {
      "source": "/api/seo-manager",
      "destination": "/api/seo-manager/"
    }
  ],
  "redirects": [
    {
      "source": "/favicon.ico",
      "destination": "/icon.svg",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/image-sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/icon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Content-Type",
          "value": "image/svg+xml; charset=utf-8"
        }
      ]
    }
  ]
}
